# App runtime
PORT=8000

# Backend database connection (managed DB recommended)
# Example: postgresql://user:password@your-managed-host:5432/your_db
DATABASE_URL=

# Frontend build-time API base (used by Vite at build)
# Point to the public URL of the API when serving the SPA
VITE_API_URL=http://localhost:8000

# Optional default date range for dashboards
VITE_DEFAULT_START=2025-05-07
VITE_DEFAULT_END=2025-11-03

# Optional local Postgres (only if using the 'db' profile)
DB_NAME=challenge_db
DB_USER=challenge
DB_PASSWORD=challenge_2024
