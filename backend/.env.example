# Exemplo de variáveis de ambiente para rodar o backend

# 1) URL única (preferencial em plataformas gerenciadas)
#DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME?sslmode=require
#DATABASE_PUBLIC_URL=postgres://USER:PASS@HOST:5432/DBNAME

# 2) Parâmetros DB_* (local/Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=challenge
DB_PASSWORD=
DB_NAME=challenge_db

# 3) Parâmetros PG* (Railway)
#PGHOST=localhost
#PGPORT=5432
#PGUSER=challenge
#PGPASSWORD=
#PGDATABASE=challenge_db

# 4) Parâmetros POSTGRES_* (Docker imagem oficial)
#POSTGRES_USER=challenge
#POSTGRES_PASSWORD=
#POSTGRES_DB=challenge_db

# Porta HTTP do backend
#PORT=8000
